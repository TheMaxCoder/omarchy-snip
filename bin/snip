#!/usr/bin/env python3
"""Snip's SQLite-backed command-line data service."""

from __future__ import annotations

import argparse
from contextlib import closing, nullcontext
import errno
import hashlib
import io
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
from urllib.parse import unquote


DATA_DIR = Path(
    os.environ.get(
        "SNIP_DATA_DIR",
        Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "snip",
    )
)
DATABASE = DATA_DIR / "snip.db"
CLIPBOARD_HISTORY = Path(
    os.environ.get(
        "SNIP_CLIPBOARD_FILE",
        Path.home() / ".local/state/omarchy/clipboard-history.json",
    )
).absolute()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
CONFIG_FILE = Path(os.environ.get("SNIP_CONFIG_FILE") or CONFIG_HOME / "snip/config.json").absolute()
HYPR_DIR = Path(os.environ.get("SNIP_HYPR_DIR") or CONFIG_HOME / "hypr")
DEFAULT_CONFIG = Path(__file__).resolve().parents[1] / "config.example.json"
KEY_MODIFIERS = {"Ctrl", "Alt", "Shift", "Super"}
PLUGIN_ID = "themaxcoder.snip"
PASTE_TOOL = "omarchy-clipboard-paste-file"
TEXT_MIME = "text/plain;charset=utf-8"
IMAGE_MISSING = "Image file missing"
ITEM_FIELDS = (
    "id, category_id AS categoryId, kind, title, body, path, mime, content_hash AS contentHash, "
    "pinned, created_at AS createdAt, updated_at AS updatedAt, last_used_at AS lastUsedAt"
)
MARKDOWN_HEADING = re.compile(r"^## (.*)$")
MARKDOWN_FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")
MARKDOWN_WRAPPER = re.compile(r"\A(`{3,})snip\n(.*)\n\1\Z", re.DOTALL)


SCHEMA = """
CREATE TABLE IF NOT EXISTS categories (
    id INTEGER PRIMARY KEY,
    name TEXT NOT NULL UNIQUE COLLATE NOCASE,
    sort_order INTEGER NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS items (
    id INTEGER PRIMARY KEY,
    category_id INTEGER REFERENCES categories(id) ON DELETE SET NULL,
    kind TEXT NOT NULL CHECK (kind IN ('text', 'image')),
    title TEXT NOT NULL,
    body TEXT NOT NULL DEFAULT '',
    path TEXT NOT NULL DEFAULT '',
    mime TEXT NOT NULL DEFAULT '',
    content_hash TEXT NOT NULL UNIQUE,
    pinned INTEGER NOT NULL DEFAULT 0 CHECK (pinned IN (0, 1)),
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    last_used_at TEXT
);

CREATE INDEX IF NOT EXISTS items_category_id ON items(category_id);
CREATE INDEX IF NOT EXISTS items_pinned ON items(pinned);

CREATE TABLE IF NOT EXISTS metadata (
    key TEXT PRIMARY KEY,
    value TEXT NOT NULL
);
"""


def create_baseline_schema(connection: sqlite3.Connection) -> None:
    # executescript() would commit the surrounding migration transaction.
    for statement in SCHEMA.strip().rstrip(";").split(";"):
        connection.execute(statement)


def migrate_saved_images(connection: sqlite3.Connection) -> None:
    data_dir = DATA_DIR.resolve()
    rows = connection.execute("SELECT id, path, content_hash FROM items WHERE kind = 'image'")
    for row in rows.fetchall():
        path = Path(row["path"])
        if not path.resolve().is_relative_to(data_dir) and path.is_file():
            owned = store_image(path, row["content_hash"])
            connection.execute("UPDATE items SET path = ? WHERE id = ?", (owned, row["id"]))


MIGRATIONS = (create_baseline_schema, migrate_saved_images)
SCHEMA_VERSION = len(MIGRATIONS)


def schema_version(connection: sqlite3.Connection) -> int:
    if connection.execute("SELECT 1 FROM sqlite_master WHERE name = 'metadata' AND type = 'table'").fetchone():
        row = connection.execute("SELECT value FROM metadata WHERE key = 'schema_version'").fetchone()
        if row is not None:
            return int(row[0])
    return 0


def migrate(connection: sqlite3.Connection) -> None:
    if schema_version(connection) == SCHEMA_VERSION:
        return
    with connection:
        connection.execute("BEGIN IMMEDIATE")
        version = schema_version(connection)
        if not 0 <= version <= SCHEMA_VERSION:
            raise ValueError(f"Unsupported Snip schema version {version}")
        for step, migration in enumerate(MIGRATIONS[version:], start=version + 1):
            migration(connection)
            connection.execute(
                "INSERT INTO metadata(key, value) VALUES ('schema_version', ?) "
                "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
                (str(step),),
            )


def connect() -> sqlite3.Connection:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    connection = sqlite3.connect(DATABASE)
    try:
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA foreign_keys = ON")
        connection.execute("PRAGMA busy_timeout = 5000")
        # SQLite can return BUSY immediately when two processes first enable WAL.
        deadline = time.monotonic() + 5
        while True:
            try:
                connection.execute("PRAGMA journal_mode = WAL").fetchone()
                break
            except sqlite3.OperationalError as error:
                if "locked" not in str(error) or time.monotonic() >= deadline:
                    raise
                time.sleep(0.02)
        migrate(connection)
    except Exception:
        connection.close()
        raise
    return connection


def output(value: object) -> None:
    json.dump(value, sys.stdout, ensure_ascii=False, separators=(",", ":"))
    sys.stdout.write("\n")


def content_hash(kind: str, body: str, path: str) -> str:
    payload = f"{kind}\0{path if kind == 'image' else body}".encode()
    return hashlib.sha256(payload).hexdigest()


def display_title(text: str, fallback: str = "Untitled") -> str:
    first_line = next((line.strip() for line in text.splitlines() if line.strip()), "")
    first_line = re.sub(r"^#{1,6}\s+", "", first_line)
    first_line = re.sub(r"^(\*\*|__)(.+)\1$", r"\2", first_line)
    return first_line[:80] or fallback


def text_subtitle(title: str, text: str) -> str:
    """Return the line after the title, or a size summary when there is none."""
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    shown = title.strip().rstrip("…").strip()
    repeats = bool(lines and shown) and (display_title(text).startswith(shown) or lines[0].startswith(shown))
    rest = lines[1:] if repeats else lines
    if rest:
        return rest[0][:100]
    count = len(text.splitlines())
    return f"{count} line{'' if count == 1 else 's'} · {len(text)} chars"


def image_subtitle(path: str, mime: str) -> str:
    """Describe an image by format, pixel size (PNG), and file size."""
    parts = [(mime.rpartition("/")[2] or "image").upper()]
    try:
        with open(path, "rb") as image:
            header = image.read(24)
            size = os.fstat(image.fileno()).st_size
    except OSError:
        return parts[0] + " · file missing"
    if header[:8] == b"\x89PNG\r\n\x1a\n" and header[12:16] == b"IHDR":
        width, height = int.from_bytes(header[16:20], "big"), int.from_bytes(header[20:24], "big")
        parts.append(f"{width}×{height}")
    parts.append(f"{size / 1024:.0f} KB" if size < 1024 * 1024 else f"{size / 1024 / 1024:.1f} MB")
    return " · ".join(parts)


def key_binding(spec: object) -> tuple[frozenset[str], str] | None:
    """Check spec structure and normalize bindings; Qt validates the key itself."""
    if not isinstance(spec, str) or not spec:
        return None
    if spec.endswith("+"):
        prefix, key = spec[:-1], "+"
        if prefix and not prefix.endswith("+"):
            return None
        modifiers = prefix[:-1].split("+") if prefix else []
    else:
        *modifiers, key = spec.split("+")
    flags = frozenset(modifiers)
    if len(flags) != len(modifiers) or not flags <= KEY_MODIFIERS:
        return None
    if key == "Backtab":
        key, flags = "Tab", flags | {"Shift"}
    if re.fullmatch(r"[A-Za-z]", key) and flags & {"Ctrl", "Alt", "Super"}:
        key = key.upper()
    return flags, key


def command_text(value: object) -> bool:
    return isinstance(value, str) and "\0" not in value and all(
        not 0xD800 <= ord(char) <= 0xDFFF for char in value
    )


def editor_argv(value: str) -> list[str]:
    if command_text(value):
        try:
            argv = shlex.split(value)
            if argv and argv[0]:
                return argv
        except ValueError:
            pass
    return []


def load_config(*, require_valid_file: bool = False) -> dict[str, object]:
    config = json.loads(DEFAULT_CONFIG.read_text(encoding="utf-8"))
    warnings = []
    try:
        user = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        user = {}
    except (OSError, ValueError, RecursionError):
        warnings.append("Could not read config as JSON; using defaults")
        user = {}
    if not isinstance(user, dict):
        warnings.append("Config must be a JSON object; using defaults")
        user = {}
    if require_valid_file and warnings:
        raise ValueError(warnings[0])

    for key, value in user.items():
        if key not in config:
            warnings.append(f"Unknown config option: {key!r}")
        elif key == "keys":
            if not isinstance(value, dict):
                warnings.append("keys must be an object; using defaults")
                continue
            for action, specs in value.items():
                if action not in config["keys"]:
                    warnings.append(f"Unknown key action: {action!r}")
                elif not isinstance(specs, list) or any(key_binding(spec) is None for spec in specs):
                    warnings.append(f"keys.{action} must be a list of key specs; using defaults")
                else:
                    config["keys"][action] = specs
        elif key == "startInSearch" and isinstance(value, bool):
            config[key] = value
        elif key == "terminal" and isinstance(value, list) and (
            not value or (value[0] and all(command_text(arg) for arg in value))
        ):
            config[key] = value
        elif key == "editor" and (value == "" or (isinstance(value, str) and editor_argv(value))):
            config[key] = value
        else:
            warnings.append(f"Invalid {key}; using default")

    bindings = {}
    for action, specs in config["keys"].items():
        for spec in specs:
            first = bindings.setdefault(key_binding(spec), action)
            if first != action:
                warnings.append(f"Key {spec!r} is bound to both {first} and {action}; {first} wins")

    return {
        **config,
        "configFile": str(CONFIG_FILE),
        "hasDefaultTerminal": shutil.which("xdg-terminal-exec") is not None,
        "warnings": warnings,
    }


def resolve_editor() -> list[str]:
    commands = (load_config()["editor"], os.environ.get("VISUAL", ""),
                os.environ.get("EDITOR", ""), "nvim", "vim", "nano")
    for command in commands:
        argv = editor_argv(command)
        if argv and shutil.which(argv[0]):
            return argv
    raise ValueError("No editor found; set editor in Snip's config, VISUAL, or EDITOR")


def read_clipboard() -> list:
    try:
        data = json.loads(CLIPBOARD_HISTORY.read_text(encoding="utf-8"))
    except (OSError, ValueError, RecursionError):
        raise ValueError("Could not read clipboard history as JSON") from None
    if not isinstance(data, list):
        raise ValueError("Clipboard history must be a JSON array")
    return data


def load_clipboard() -> list[dict[str, object]]:
    try:
        data = read_clipboard()
    except ValueError:
        return []

    entries: list[dict[str, object]] = []
    for entry in data:
        if not isinstance(entry, dict):
            continue
        kind = entry.get("type", "text")
        if kind == "image":
            path = entry.get("path", "")
            if not path or not command_text(path):
                continue
            entries.append(
                {
                    "ref": content_hash("image", "", path),
                    "kind": "image",
                    "imageMissing": image_missing(path),
                    "title": f"Screenshot · {entry.get('capturedAt', 'image')}",
                    "body": "",
                    "path": path,
                    "mime": str(entry.get("mime", "image/png")),
                    "subtitle": image_subtitle(path, str(entry.get("mime", "image/png"))),
                }
            )
            continue

        text = entry.get("text", "")
        if not isinstance(text, str) or not text.strip():
            continue
        try:
            ref = content_hash("text", text, "")
        except UnicodeEncodeError:
            continue
        subtitle = text_subtitle(display_title(text), text)
        entries.append(
            {
                "ref": ref,
                "kind": "text",
                "title": display_title(text),
                "body": text,
                "path": "",
                "mime": "text/plain",
                "subtitle": subtitle,
            }
        )
    return entries


def clipboard_entry(ref: str) -> dict[str, object]:
    for entry in load_clipboard():
        if entry["ref"] == ref:
            return entry
    raise ValueError("That clipboard item is no longer in history")


def image_missing(path: str) -> bool:
    try:
        return not path or not Path(path).is_file()
    except OSError:
        return True


def store_image(source: Path, digest: str) -> str:
    if image_missing(str(source)):
        raise ValueError(IMAGE_MISSING)
    directory = DATA_DIR.resolve() / "images"
    if directory.is_symlink():
        raise ValueError("Snip's images directory must not be a symlink")
    directory.mkdir(exist_ok=True)
    if not re.fullmatch(r"[a-f0-9]{64}", digest):
        raise ValueError("Invalid saved image hash")
    # Keep the original clipboard digest as the saved item's identity.
    suffix = source.suffix or ".img"
    target = directory / (digest + suffix)
    if target.is_symlink():
        raise ValueError("Snip's saved image path must not be a symlink")
    if target.is_file():
        return str(target)
    try:
        os.link(source.resolve(), target)
    except OSError as error:
        if error.errno not in (errno.EXDEV, errno.EPERM):
            raise
        with tempfile.NamedTemporaryFile(dir=directory, delete=False) as temporary:
            copy = Path(temporary.name)
        try:
            shutil.copyfile(source, copy)
            copy.replace(target)
        finally:
            copy.unlink(missing_ok=True)
    return str(target)


def delete_item(connection: sqlite3.Connection, item: sqlite3.Row) -> None:
    connection.execute("DELETE FROM items WHERE id = ?", (item["id"],))
    if item["kind"] != "image" or not item["path"]:
        return
    path = Path(item["path"])
    if path.parent.resolve() != DATA_DIR.resolve() / "images":
        return
    for row in connection.execute("SELECT path FROM items WHERE kind = 'image'"):
        if Path(row["path"]).resolve() == path.resolve():
            return
    path.unlink(missing_ok=True)


def upsert_clipboard_item(
    connection: sqlite3.Connection,
    ref: str,
    *,
    category_id: int | None = None,
    pin: bool = False,
) -> int:
    entry = clipboard_entry(ref)
    kind = entry["kind"]
    path = entry["path"]
    if kind == "image":
        path = store_image(Path(path), ref)
    row = connection.execute(
        "INSERT INTO items "
        "(category_id, kind, title, body, path, mime, content_hash, pinned) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?) "
        "ON CONFLICT(content_hash) DO UPDATE SET "
        "category_id = COALESCE(excluded.category_id, items.category_id), "
        "pinned = MAX(items.pinned, excluded.pinned), path = excluded.path, "
        "updated_at = CURRENT_TIMESTAMP RETURNING id",
        (category_id, kind, entry["title"], entry["body"], path, entry["mime"], ref, int(pin)),
    ).fetchone()
    return int(row[0])


def library_categories(connection: sqlite3.Connection) -> list[dict[str, object]]:
    return [
        dict(row)
        for row in connection.execute(
            "SELECT id, name, sort_order AS sortOrder FROM categories ORDER BY sort_order, name"
        )
    ]


def item_record(row: sqlite3.Row) -> dict[str, object]:
    item = dict(row)
    item["pinned"] = bool(item["pinned"])
    return item


def library_items(connection: sqlite3.Connection) -> list[dict[str, object]]:
    return [
        item_record(row)
        for row in connection.execute(
            f"SELECT {ITEM_FIELDS} FROM items "
            "ORDER BY pinned DESC, COALESCE(last_used_at, updated_at) DESC, id DESC"
        )
    ]


def snapshot(connection: sqlite3.Connection) -> dict[str, object]:
    categories = library_categories(connection)
    names = {category["id"]: category["name"] for category in categories}
    items = library_items(connection)
    for item in items:
        item.pop("contentHash")
        item.pop("lastUsedAt")
        item["categoryName"] = names.get(item["categoryId"], "")
        if item["kind"] == "image":
            item["imageMissing"] = image_missing(item["path"])
        if item["kind"] == "image":
            item["subtitle"] = image_subtitle(item["path"], item["mime"])
        else:
            item["subtitle"] = text_subtitle(item["title"], item["body"])
    return {
        "categories": categories,
        "items": items,
        "inbox": load_clipboard(),
        "clipboardFile": str(CLIPBOARD_HISTORY),
    }


def markdown_filename(name: str) -> str:
    # Escape path separators and '%' itself; Pinned.md is reserved.
    stem = re.sub(r"[%/\\\x00-\x1f\x7f]", lambda match: f"%{ord(match[0]):02X}", name)
    if stem.casefold() == "pinned":
        stem = f"%{ord(stem[0]):02X}" + stem[1:]
    return stem + ".md"


def markdown_record(item: dict[str, object]) -> str:
    # Keep a Markdown heading on one line without losing the original title.
    title = item["title"].replace("&", "&amp;").replace("\r", "&#13;").replace("\n", "&#10;")
    body = item["body"]
    # Fence headings and existing fences so neither can split a Snip record.
    if any(line.startswith("## ") or MARKDOWN_FENCE.match(line) for line in body.splitlines()):
        longest = max((len(run) for run in re.findall(r"`+", body)), default=0)
        fence = "`" * max(3, longest + 1)
        body = f"{fence}snip\n{body}\n{fence}"
    return f"## {title}\n{body}\n\n"


def export_library(connection: sqlite3.Connection, args: argparse.Namespace) -> None:
    with connection:
        connection.execute("BEGIN")
        categories = library_categories(connection)
        items = library_items(connection)
    if args.format == "json":
        if args.skip_images:
            text = [item for item in items if item["kind"] == "text"]
            if len(text) != len(items):
                print(f"Skipped {len(items) - len(text)} image item(s)", file=sys.stderr)
            items = text
        data = {"format": "snip", "version": 1, "categories": categories, "items": items}
        if args.output is None:
            output(data)
        else:
            args.output.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        return

    groups = {category["id"]: [] for category in categories}
    groups[None] = []
    for item in items:
        if item["kind"] == "text":
            groups[item["categoryId"]].append(markdown_record(item))
    args.output.mkdir(parents=True, exist_ok=True)
    for category in categories:
        path = args.output / markdown_filename(category["name"])
        path.write_text("".join(groups[category["id"]]), encoding="utf-8")
    (args.output / "Pinned.md").write_text("".join(groups[None]), encoding="utf-8")


def markdown_items(raw: str) -> list[tuple[str, str]]:
    items = []
    title = None
    body = []
    fence = ""

    def finish() -> None:
        if title is None:
            return
        text = "".join(body)
        # A Snip export writes two separator newlines, even for an empty body.
        if text.endswith("\n\n"):
            text = text[:-2]
        elif text.endswith("\r\n"):
            text = text[:-2]
        else:
            text = text.removesuffix("\n")
        wrapper = MARKDOWN_WRAPPER.fullmatch(text)
        items.append((title, wrapper[2] if wrapper else text))

    for line in io.StringIO(raw):
        value = line.removesuffix("\n").removesuffix("\r")
        marker = MARKDOWN_FENCE.fullmatch(value)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence) and not marker[2].strip():
                fence = ""
        elif marker:
            fence = marker[1]
        else:
            heading = MARKDOWN_HEADING.fullmatch(value)
            if heading:
                finish()
                escapes = {"&amp;": "&", "&#13;": "\r", "&#10;": "\n"}
                title = re.sub(r"&(?:amp|#13|#10);", lambda match: escapes[match[0]], heading[1])
                body = []
                continue
        if title is not None:
            body.append(line)
    finish()
    if not items and raw.strip():
        items.append((display_title(raw), raw))
    return items


def category_for_name(connection: sqlite3.Connection, name: str) -> int:
    connection.execute(
        "INSERT OR IGNORE INTO categories(name, sort_order) VALUES "
        "(?, (SELECT COALESCE(MAX(sort_order), 0) + 1 FROM categories))", (name,)
    )
    return connection.execute("SELECT id FROM categories WHERE name = ? COLLATE NOCASE", (name,)).fetchone()[0]


def insert_imported_item(
    connection: sqlite3.Connection, category_id: int | None, item: dict[str, object], source_dir: Path
) -> bool:
    kind = item.get("kind", "text")
    title = item.get("title")
    body = item.get("body", "")
    path = item.get("path", "")
    mime = item.get("mime", "text/plain" if kind == "text" else "image/png")
    pinned = item.get("pinned", category_id is None)
    dates = tuple(item.get(field) for field in ("createdAt", "updatedAt", "lastUsedAt"))
    if (kind not in ("text", "image") or not isinstance(title, str) or not isinstance(body, str)
            or not command_text(path) or not command_text(mime) or not isinstance(pinned, bool)
            or any(date is not None and not isinstance(date, str) for date in dates)):
        raise ValueError("Invalid item in Snip import")
    digest = content_hash(kind, body, path)
    if kind == "image":
        if not path:
            raise ValueError("An imported image must have a path")
        # The exported hash identifies the original clipboard path, not Snip's link.
        recorded = item.get("contentHash")
        if isinstance(recorded, str) and re.fullmatch(r"[a-f0-9]{64}", recorded):
            digest = recorded
        if connection.execute("SELECT 1 FROM items WHERE content_hash = ?", (digest,)).fetchone():
            return False
        image = (source_dir / path).absolute()
        path = str(image) if image_missing(str(image)) else store_image(image, digest)
    cursor = connection.execute(
        "INSERT INTO items(category_id, kind, title, body, path, mime, content_hash, pinned, "
        "created_at, updated_at, last_used_at) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?, COALESCE(?, CURRENT_TIMESTAMP), COALESCE(?, CURRENT_TIMESTAMP), ?) "
        "ON CONFLICT(content_hash) DO NOTHING",
        (category_id, kind, title, body, path, mime, digest, int(pinned), *dates),
    )
    return cursor.rowcount == 1


def read_import(path: Path):
    if not path.is_dir() and path.suffix.lower() != ".md":
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (ValueError, RecursionError):
            raise ValueError("Could not read Snip export as JSON") from None
        if (not isinstance(data, dict) or data.get("format") != "snip" or type(data.get("version")) is not int
                or data["version"] != 1 or not isinstance(data.get("categories"), list)
                or not isinstance(data.get("items"), list)):
            raise ValueError("Expected a Snip JSON export (version 1)")
        categories = {}
        for category in data["categories"]:
            if (not isinstance(category, dict) or type(category.get("id")) is not int
                    or not isinstance(category.get("name"), str) or not category["name"].strip()
                    or category["id"] in categories):
                raise ValueError("Invalid category in Snip export")
            categories[category["id"]] = category["name"]
        items = []
        # Exports are newest-first; insert oldest-first so equal timestamps
        # still tie-break by recency with the new local IDs.
        for item in reversed(data["items"]):
            if not isinstance(item, dict):
                raise ValueError("Invalid item in Snip export")
            category_id = item.get("categoryId")
            if category_id is not None and (type(category_id) is not int or category_id not in categories):
                raise ValueError("Item refers to an unknown category in Snip export")
            items.append((categories.get(category_id), item))
        return list(categories.values()), items, path.parent

    files = sorted(path.glob("*.md")) if path.is_dir() else [path]
    categories = []
    items = []
    for file in files:
        if file.is_dir():
            continue
        category = None if file.stem == "Pinned" else unquote(file.stem)
        if category is not None:
            categories.append(category)
        raw = file.read_bytes().decode("utf-8")
        items.extend((category, {"title": title, "body": body}) for title, body in markdown_items(raw))
    return categories, items, path.parent


def import_library(connection: sqlite3.Connection, path: Path) -> dict[str, int]:
    categories, items, source_dir = read_import(path)
    with connection:
        connection.execute("BEGIN IMMEDIATE")
        category_ids = {name: category_for_name(connection, name) for name in categories}
        imported = sum(insert_imported_item(connection, category_ids.get(category), item, source_dir)
                       for category, item in items)
    return {"imported": imported, "skipped": len(items) - imported}


def run_command(
    argv: list[str], failure: str, *, terminal=None, fail_on_stderr: bool = False
) -> subprocess.CompletedProcess:
    # The clipboard owner can outlive the paste helper. Avoid pipes it could
    # hold open, while still detecting errors the helper prints but masks.
    log = tempfile.TemporaryFile(dir=os.environ.get("XDG_RUNTIME_DIR") or None) if fail_on_stderr else nullcontext()
    with log as diagnostics:
        try:
            result = subprocess.run(
                argv, stdout=subprocess.DEVNULL if diagnostics else terminal or subprocess.PIPE,
                stderr=diagnostics or terminal or subprocess.PIPE,
                encoding="utf-8", errors="replace", check=False,
            )
        except (OSError, ValueError, subprocess.SubprocessError):
            raise ValueError(failure) from None
        if result.returncode:
            raise ValueError(failure)
        if diagnostics:
            diagnostics.seek(0)
            if diagnostics.read().strip():
                raise ValueError(failure)
        return result


def paste_tool() -> str | None:
    omarchy = os.environ.get("OMARCHY_PATH")
    if omarchy:
        bundled = shutil.which(str(Path(omarchy).absolute() / "bin" / PASTE_TOOL))
        if bundled:
            return bundled
    return shutil.which(PASTE_TOOL)


def require_tool(name: str) -> None:
    if not shutil.which(name):
        raise ValueError(f"{name} not found on PATH")


def paste_item(item: sqlite3.Row | dict[str, object], copy_only: bool) -> None:
    is_image = item["kind"] == "image"
    if is_image and image_missing(item["path"]):
        raise ValueError(IMAGE_MISSING)
    tool = paste_tool()
    if not tool:
        raise ValueError(f"{PASTE_TOOL} not found in OMARCHY_PATH or on PATH")
    require_tool("wl-copy")
    if not copy_only:
        require_tool("wtype")
    argv = [tool, "--copy-only"] if copy_only else [tool]
    failure = ("Omarchy could not copy the item; check wl-copy" if copy_only else
               "Omarchy could not paste the item; check wl-copy and wtype")
    # Some versions of the helper report wl-copy errors on stderr but exit 0.
    if is_image:
        run_command([*argv, item["mime"], item["path"]], failure, fail_on_stderr=True)
        return
    temporary_path = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", prefix="snip-paste-",
            dir=os.environ.get("XDG_RUNTIME_DIR") or None, delete=False,
        ) as temporary:
            temporary_path = Path(temporary.name)
            temporary.write(item["body"])
        run_command([*argv, TEXT_MIME, str(temporary_path)], failure, fail_on_stderr=True)
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def current_clipboard_text(*, primary: bool = False) -> str:
    require_tool("wl-paste")
    argv = ["wl-paste", "--type", "text", "--no-newline"]
    if primary:
        argv.append("--primary")
    return run_command(argv, "Could not read text from the clipboard with wl-paste").stdout


def capture(connection: sqlite3.Connection, args: argparse.Namespace) -> dict[str, object]:
    if args.stdin:
        body = sys.stdin.buffer.read().decode("utf-8")
        body = body[:-2] if body.endswith("\r\n") else body.removesuffix("\n")
    else:
        body = current_clipboard_text(primary=args.primary)
    if not body.strip():
        raise ValueError("No text to save" if args.stdin else "clipboard is empty or does not contain text")
    title = (args.title or "").strip() or display_title(body)
    category = args.category.strip() if args.category is not None else None
    if category == "":
        raise ValueError("category name cannot be empty")
    with connection:
        connection.execute("BEGIN IMMEDIATE")
        category_id = None if category is None else category_for_name(connection, category)
        row = connection.execute(
            "INSERT INTO items(category_id, kind, title, body, mime, content_hash, pinned) "
            "VALUES (?, 'text', ?, ?, 'text/plain', ?, ?) "
            "ON CONFLICT(content_hash) DO UPDATE SET category_id = excluded.category_id, "
            "title = excluded.title, pinned = MAX(items.pinned, excluded.pinned), "
            f"updated_at = CURRENT_TIMESTAMP RETURNING {ITEM_FIELDS}",
            (category_id, title, body, content_hash("text", body, ""), int(args.pin or category is None)),
        ).fetchone()
    if args.notify:
        notify("Snip saved a snippet", title)
    return item_record(row)


def edit_file(editor: list[str], path: Path) -> None:
    argv = [*editor, str(path)]
    failure = "The editor could not finish editing the snippet"
    # Keep the interactive editor on the terminal without mixing its output
    # into the backend's JSON result or stderr diagnostic.
    try:
        terminal = open("/dev/tty", "w", encoding="utf-8") if sys.stdin.isatty() else None
    except OSError:
        terminal = None
    with terminal or nullcontext():
        run_command(argv, failure, terminal=terminal)


def notify(summary: str, message: str) -> None:
    if shutil.which("notify-send"):
        try:
            subprocess.run(
                ["notify-send", "-a", "Snip", summary, message],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False,
            )
        except (OSError, ValueError, subprocess.SubprocessError):
            pass


def has_hypr_binding() -> bool:
    token = re.compile(rf"(?<![\w.-]){re.escape(PLUGIN_ID)}(?![\w.-])")
    seen = set()
    pending = [HYPR_DIR]
    while pending:
        path = pending.pop()
        try:
            info = path.stat()
            if stat.S_ISDIR(info.st_mode):
                identity = (info.st_dev, info.st_ino)
                if identity not in seen:
                    seen.add(identity)
                    pending.extend(path.iterdir())
            elif stat.S_ISREG(info.st_mode) and path.suffix in (".lua", ".conf"):
                if token.search(path.read_text(encoding="utf-8")):
                    return True
        except (OSError, UnicodeError):
            continue
    return False


def doctor() -> int:
    required_ok = True

    def check(label: str, ok: bool, hint: str, *, required: bool = True) -> None:
        nonlocal required_ok
        if required and not ok:
            required_ok = False
        print(f"{'✓' if ok else '✗'} {label} — {'OK' if ok else hint}")

    check(f"Python {sys.version.split()[0]}", sys.version_info >= (3, 10), "Use Python 3.10 or newer")
    check(PASTE_TOOL, paste_tool() is not None, "Use Omarchy 4 or check OMARCHY_PATH and PATH")
    for tool in ("wl-copy", "wl-paste", "wtype"):
        check(tool, shutil.which(tool) is not None, f"Install {'wtype' if tool == 'wtype' else 'wl-clipboard'}")
    check("xdg-terminal-exec", shutil.which("xdg-terminal-exec") is not None,
          "Set terminal in Snip's config or install xdg-terminal-exec", required=False)
    try:
        read_clipboard()
    except ValueError:
        check("Clipboard history", False, "Enable omarchy.clipboard and copy an item", required=False)
    else:
        check("Clipboard history", True, "")
    try:
        config = load_config(require_valid_file=True)
    except (OSError, ValueError) as error:
        check("Config", False, f"Fix {CONFIG_FILE}: {error}")
    else:
        check("Config", True, "")
        for warning in config["warnings"]:
            check("Config warning", False, warning, required=False)
    try:
        with closing(connect()) as connection:
            integrity = [row[0] for row in connection.execute("PRAGMA integrity_check")]
            db_ok = integrity == ["ok"] and schema_version(connection) == SCHEMA_VERSION
    except (OSError, sqlite3.Error, ValueError):
        db_ok = False
    check(f"Database (schema {SCHEMA_VERSION})", db_ok, f"Check access to {DATABASE} or restore a backup")
    check("Hyprland binding", has_hypr_binding(),
          f'Add o.rebind("SUPER + CTRL + V", "Snip", {{ panel = "{PLUGIN_ID}" }})', required=False)
    return 0 if required_ok else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Manage the Snip library. Run snip with no arguments to toggle the picker.",
        epilog="Run snip COMMAND --help for command-specific options.",
    )
    # A metavar hides the full choices list; parsers without help stay off the menu.
    subparsers = parser.add_subparsers(dest="command", required=True, metavar="COMMAND", title="commands")
    subparsers.add_parser("snapshot")
    subparsers.add_parser(
        "config",
        help="show effective settings and warnings as JSON",
        description="Show defaults merged with ${XDG_CONFIG_HOME:-~/.config}/snip/config.json, with validation warnings.",
        epilog=(
            "Key specs use Ctrl, Alt, Shift, and Super plus a printable character or a Qt key "
            "name without Key_. Qt resolves named keys and requires exact modifiers. For "
            "printable keys without Ctrl, Alt or Super, Shift is only required when written "
            "explicitly; text still matches case-sensitively, so G and Shift+G both match a "
            "shifted G. With Ctrl, Alt or Super, modifiers are exact and ASCII letters are "
            "case-insensitive. The backend warns about duplicate bindings across actions; "
            "the first eligible action in default keymap order wins. In search and new-tab "
            "input, Return/Enter confirm and Escape goes back regardless of settings; plain "
            "printable keys are not action shortcuts. Digits 0–9 jump to tabs "
            "when neither modal is open."
        ),
    )

    pin = subparsers.add_parser("pin-inbox")
    pin.add_argument("--ref", required=True)

    save = subparsers.add_parser("save-inbox")
    save.add_argument("--ref", required=True)
    save.add_argument("category_id", type=int)

    save_new = subparsers.add_parser("save-inbox-new")
    save_new.add_argument("--ref", required=True)
    save_new.add_argument("name")

    paste = subparsers.add_parser(
        "paste", help="paste or copy a saved snippet or clipboard item",
        description="Copy an item to the clipboard and paste it into the focused window.",
    )
    source = paste.add_mutually_exclusive_group(required=True)
    source.add_argument("--id", type=int, metavar="ID", help="saved item ID, as shown by snip add or export")
    source.add_argument("--ref", metavar="HASH", help="content hash of a current clipboard history item")
    paste.add_argument("--copy-only", action="store_true", help="copy to the clipboard without pasting")
    subparsers.add_parser(
        "doctor", help="check dependencies and diagnose your setup",
        description="Check tools, clipboard history, configuration, database integrity, and Hyprland bindings. "
        "Exits nonzero if a required check fails.",
    )

    toggle = subparsers.add_parser("toggle-pin")
    toggle.add_argument("item_id", type=int)

    delete = subparsers.add_parser("delete")
    delete.add_argument("item_id", type=int)

    delete_category = subparsers.add_parser("delete-category")
    delete_category.add_argument("category_id", type=int)

    edit = subparsers.add_parser(
        "edit", help="open a saved text snippet in your editor",
        description="Edit a saved text snippet. The first line is the title; the rest is the body.",
    )
    edit.add_argument("item_id", type=int, metavar="ID", help="saved item ID, as shown by snip add or export")

    category = subparsers.add_parser("create-category")
    category.add_argument("name")

    add = subparsers.add_parser(
        "add", help="save text from the clipboard, primary selection, or stdin",
        description="Save a text snippet and print the saved item as JSON.",
        epilog=(
            "Example for ~/.config/hypr/bindings.lua (snip must be on PATH):\n"
            '  o.bind("SUPER + CTRL + SHIFT + V", "Save selection to Snip", "snip add --primary --notify")'
        ), formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    capture_source = add.add_mutually_exclusive_group()
    capture_source.add_argument("--primary", action="store_true", help="read the primary selection")
    capture_source.add_argument("--stdin", action="store_true", help="read UTF-8 stdin and remove one trailing newline")
    add.add_argument("--category", metavar="NAME", help="save to this tab, creating it if needed; default: Pinned")
    add.add_argument("--title", help="override the title derived from the first non-empty line")
    add.add_argument("--pin", action="store_true", help="pin the item even when saving to a category")
    add.add_argument("--notify", action="store_true", help="send a desktop notification if notify-send is available")

    export = subparsers.add_parser(
        "export", help="export the library as JSON or Markdown",
        description="Export Snip as JSON or Markdown. JSON images are referenced by path, not embedded.",
        epilog="Use JSON to preserve metadata. Markdown is text-only and stores only titles, bodies, and categories.",
    )
    export.add_argument("--format", choices=("json", "markdown"), default="json", help="output format (default: json)")
    export.add_argument("--output", type=Path, metavar="PATH", help="JSON file (default: stdout) or Markdown directory")
    export.add_argument("--skip-images", action="store_true", help="omit images from JSON exports")

    import_parser = subparsers.add_parser(
        "import", help="import snippets from JSON or Markdown",
        description="Import snippets, skipping duplicate content and printing the imported and skipped counts.",
        epilog="Markdown categories come from the filenames; Pinned.md holds uncategorized, pinned items.",
    )
    import_parser.add_argument("path", type=Path, metavar="PATH", help="Snip JSON export, .md file, or directory of .md files")

    used = subparsers.add_parser("used")
    used.add_argument("item_id", type=int)
    return parser


def existing_category_id(connection: sqlite3.Connection, category_id: int) -> int:
    row = connection.execute("SELECT id FROM categories WHERE id = ?", (category_id,)).fetchone()
    if row is None:
        raise ValueError(f"unknown category: {category_id}")
    return int(row[0])


def main() -> int:
    args = None
    try:
        if len(sys.argv) == 1:
            result = run_command(["omarchy-shell", "shell", "toggle", PLUGIN_ID, "{}"],
                                 "Could not open Snip through omarchy-shell")
            sys.stdout.write(result.stdout)
            return 0
        args = build_parser().parse_args()
        if args.command == "config":
            output(load_config())
            return 0
        if args.command == "doctor":
            return doctor()
        if args.command == "export" and args.format == "markdown" and args.output is None:
            raise ValueError("Markdown export requires --output DIR")
        with closing(connect()) as connection:
            if args.command == "snapshot":
                output(snapshot(connection))
            elif args.command in ("pin-inbox", "save-inbox"):
                with connection:
                    connection.execute("BEGIN IMMEDIATE")
                    pin = args.command == "pin-inbox"
                    category_id = None if pin else existing_category_id(connection, args.category_id)
                    item_id = upsert_clipboard_item(connection, args.ref, category_id=category_id, pin=pin)
                output({"ok": True, "id": item_id})
            elif args.command == "save-inbox-new":
                name = args.name.strip()
                if not name:
                    raise ValueError("category name cannot be empty")
                with connection:
                    connection.execute("BEGIN IMMEDIATE")
                    category_id = category_for_name(connection, name)
                    item_id = upsert_clipboard_item(
                        connection, args.ref, category_id=category_id
                    )
                output({"ok": True, "id": item_id, "categoryId": category_id})
            elif args.command in ("toggle-pin", "delete"):
                with connection:
                    connection.execute("BEGIN IMMEDIATE")
                    item = connection.execute(
                        "SELECT id, category_id, pinned, kind, path FROM items WHERE id = ?",
                        (args.item_id,),
                    ).fetchone()
                    if item is None:
                        raise ValueError("snippet no longer exists")
                    if args.command == "delete" or (item["category_id"] is None and item["pinned"]):
                        delete_item(connection, item)
                    else:
                        connection.execute(
                            "UPDATE items SET pinned = NOT pinned, updated_at = CURRENT_TIMESTAMP WHERE id = ?",
                            (args.item_id,),
                        )
                output({"ok": True})
            elif args.command == "delete-category":
                category = connection.execute(
                    "SELECT name FROM categories WHERE id = ?", (args.category_id,)
                ).fetchone()
                if category is None:
                    raise ValueError("category no longer exists")
                with connection:
                    moved = connection.execute(
                        "UPDATE items SET pinned = 1, updated_at = CURRENT_TIMESTAMP "
                        "WHERE category_id = ?",
                        (args.category_id,),
                    ).rowcount
                    connection.execute(
                        "DELETE FROM categories WHERE id = ?", (args.category_id,)
                    )
                output({"ok": True, "name": category["name"], "moved": moved})
            elif args.command == "edit":
                item = connection.execute(
                    "SELECT kind, title, body, content_hash FROM items WHERE id = ?", (args.item_id,)
                ).fetchone()
                if item is None:
                    raise ValueError("snippet no longer exists")
                if item["kind"] != "text":
                    raise ValueError("image entries cannot be edited as text")
                editor = resolve_editor()
                runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()))
                with tempfile.NamedTemporaryFile(
                    mode="w",
                    encoding="utf-8",
                    prefix="snip-edit-",
                    suffix=".md",
                    dir=runtime_dir,
                    delete=False,
                ) as temporary:
                    temporary.write(f"# {item['title']}\n\n{item['body']}\n")
                    edit_path = Path(temporary.name)
                try:
                    edit_file(editor, edit_path)
                    edited = edit_path.read_text(encoding="utf-8")
                except BaseException:
                    edit_path.unlink(missing_ok=True)
                    raise
                first, separator, remainder = edited.partition("\n")
                title = re.sub(r"^#\s+", "", first).strip()
                body = remainder.lstrip("\n").rstrip() if separator else ""
                kept = f"; your text is kept in {edit_path}"
                if not title:
                    raise ValueError("the first line must contain a snippet title" + kept)
                # IDs can be reused after a delete, so save only over the snippet that was opened.
                try:
                    with connection:
                        saved = connection.execute(
                            "UPDATE items SET title = ?, body = ?, content_hash = ?, "
                            "updated_at = CURRENT_TIMESTAMP WHERE id = ? AND content_hash = ?",
                            (title, body, content_hash("text", body, ""), args.item_id, item["content_hash"]),
                        ).rowcount
                except sqlite3.IntegrityError:
                    raise ValueError("another snippet already has this text" + kept) from None
                if not saved:
                    raise ValueError("the snippet changed or was deleted while you edited it" + kept)
                edit_path.unlink(missing_ok=True)
                output({"ok": True})
            elif args.command == "create-category":
                name = args.name.strip()
                if not name:
                    raise ValueError("category name cannot be empty")
                with connection:
                    order = connection.execute(
                        "SELECT COALESCE(MAX(sort_order), 0) + 1 FROM categories"
                    ).fetchone()[0]
                    cursor = connection.execute(
                        "INSERT INTO categories(name, sort_order) VALUES (?, ?)",
                        (name, order),
                    )
                output({"ok": True, "id": cursor.lastrowid})
            elif args.command == "add":
                output(capture(connection, args))
            elif args.command == "export":
                export_library(connection, args)
            elif args.command == "import":
                output(import_library(connection, args.path))
            elif args.command in ("paste", "used"):
                item_id = args.item_id if args.command == "used" else args.id
                if args.command == "paste":
                    if args.ref is not None:
                        item = clipboard_entry(args.ref)
                    else:
                        item = connection.execute(
                            "SELECT kind, body, path, mime FROM items WHERE id = ?", (item_id,)
                        ).fetchone()
                        if item is None:
                            raise ValueError("snippet no longer exists")
                    paste_item(item, args.copy_only)
                if item_id is not None:
                    with connection:
                        connection.execute(
                            "UPDATE items SET last_used_at = CURRENT_TIMESTAMP WHERE id = ?", (item_id,)
                        )
                output({"ok": True})
    except (OSError, sqlite3.Error, subprocess.SubprocessError, ValueError) as error:
        message = " ".join(str(error).splitlines())
        print(f"snip: {message}", file=sys.stderr)
        if args is not None and args.command == "paste" and not args.copy_only:
            notify("Snip could not paste", message)
        elif args is not None and args.command == "edit":
            notify("Snip could not save the edit", message)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
